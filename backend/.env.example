# Copy to backend/.env and fill in. Never commit .env.
# Relative paths are resolved against backend/.

LOG_ROOT=../MAIT_Makeathon_Logpaket
DB_PATH=../data/logtracer.duckdb

LLM_PROVIDER=claude            # claude | gemini
LLM_MODEL=claude-sonnet-5-5    # with gemini: gemini-2.5-flash
ANTHROPIC_API_KEY=
GEMINI_API_KEY=                # from https://aistudio.google.com/apikey

WATCH_ENABLED=false
