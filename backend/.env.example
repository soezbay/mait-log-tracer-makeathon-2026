# Log Tracer backend configuration.
# Copy to backend/.env and adjust. Never commit .env (it is git-ignored).
# Relative paths are resolved against backend/. All values shown are the defaults.

# --- Paths ---------------------------------------------------------------------------
# Original log package (read only, never modified)
LOG_ROOT=../MAIT_Makeathon_Logpaket
# The package as ZIP, versioned with Git LFS (run `git lfs pull` once after cloning)
LOGPAKET_ZIP=../MAIT_Makeathon_Logpaket.zip
# Extract the ZIP into LOG_ROOT on program start if not extracted yet (checked every start)
AUTO_EXTRACT=true
# Download the ZIP with `git lfs pull` on program start if it is missing or only an LFS pointer
AUTO_DOWNLOAD=true
# Main DuckDB file (derived, rebuildable with scripts/ingest.py)
DB_PATH=../data/logtracer.duckdb
# Small test database from the demo scenario files (scripts/make_fixture.py)
FIXTURE_DB_PATH=../data/fixture.duckdb
# Test questions + ground truth for the evaluation (P5)
EVAL_QUESTIONS_PATH=../eval/questions.yaml

# --- API server ----------------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8000
# Auto-reload on code changes (development only)
API_RELOAD=true
# Allowed browser origins, JSON list (Vite dev server)
CORS_ORIGINS=["http://localhost:5173"]
# critical | error | warning | info | debug
LOG_LEVEL=info

# --- Ingest (P1) ---------------------------------------------------------------------
# Events per insert batch
INGEST_BATCH_SIZE=50000
# Parallel parser processes (1 = sequential); there is always exactly one DB writer
INGEST_WORKERS=1
# Time zone assumed for timestamps without one (import_*.log); events get tz_assumed=true
DEFAULT_TIMEZONE=UTC

# --- Continuous ingest / watcher (P1, day 3) -----------------------------------------
WATCH_ENABLED=false
# Seconds to wait after the last file change before ingesting
WATCH_DEBOUNCE_S=1.5
# Safety net next to the watcher: check all files (size/mtime) every N seconds; 0 = off.
# Needed because file-change notifications on Windows can be delayed or lost.
WATCH_RESCAN_S=10

# --- LLM / AI assistant (P3) ---------------------------------------------------------
# claude | gemini | groq | kiconnect | ollama
LLM_PROVIDER=claude
# Model ID; empty = provider default (claude-sonnet-5-5 / gemini-3.6-flash / openai/gpt-oss-120b)
LLM_MODEL=claude-sonnet-5-5
# Secrets: only in backend/.env, never in Git
ANTHROPIC_API_KEY=
# Gemini key from https://aistudio.google.com/apikey (free tier available)
GEMINI_API_KEY=
# Groq key from https://console.groq.com/keys (free plan available)
GROQ_API_KEY=
# KI:connect.nrw key (university account); LLM_MODEL = a deployment name, list them with
# `uv run python scripts/ask.py --list-models`
KICONNECT_API_KEY=
# Empty = https://chat.kiconnect.nrw/api/v1
KICONNECT_BASE_URL=
# Groq reasoning models only: low | medium | high; empty = model default. Lower is faster.
LLM_REASONING_EFFORT=
# Tool-use rounds per question and output limit
LLM_MAX_TOOL_ROUNDS=8
LLM_MAX_OUTPUT_TOKENS=4096
# Local LLM (privacy option)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
